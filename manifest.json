{
  "manifest_version": 3,
  "name": "LinearCN",
  "short_name": "LinearCN",
  "description": "面向新版 Linear 的增强简体中文本地化",
  "version": "1.0.0",
  "icons": {
    "16": "img/favicon-16x16.png",
    "48": "img/favicon-48x48.png",
    "128": "img/favicon-128x128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://linear.app/*", "*://*.linear.app/*"],
      "js": [
        "js/translations-base.js",
        "js/translations-enhanced.js",
        "js/translations-settings.js",
        "js/translations-settings-nested.js",
        "js/translations-integrations.js",
        "js/translations-quality.js",
        "js/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
